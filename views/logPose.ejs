<!DOCTYPE html>
<html lang="en" data-theme="night">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log Pose | Grand Line Registry</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="min-h-screen bg-base-100">
  <main class="container mx-auto px-4 py-4">
    <%- include('partials/navbar', { title: 'Secret Log Pose' }) %>
    <div role="alert" class="alert alert-info mb-6 break-all"><span><%= log %></span></div>
    <div class="hero bg-base-200 rounded-box p-10 mb-6"><div class="text-center"><h1 class="text-4xl font-bold">Destination Reached</h1><p class="mt-3">The Log Pose points toward Wano! Prepare for the next adventure.</p></div></div>
    <h2 class="text-2xl font-bold mb-4">Active Crew</h2>
    <div class="overflow-x-auto bg-base-200 rounded-box"><table class="table table-zebra"><thead><tr><th>Name</th><th>Role</th><th>Bounty</th></tr></thead><tbody>
      <% for (const member of crew) { %>
        <% if (member.status === 'active') { %>
          <tr><td><%= member.name %></td><td><%= member.role %></td><td><%= Number(member.bounty).toLocaleString('en-US') %> Berries</td></tr>
        <% } %>
      <% } %>
    </tbody></table></div>
  </main>
</body>
</html>
